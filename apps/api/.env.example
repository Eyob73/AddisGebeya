# Server
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (example: postgresql://addisgebeya:addisgebeya_dev@localhost:5432/addisgebeya_dev?schema=public)
DATABASE_URL=

# JWT Secrets (use long random strings in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth 2.0 (Keep Client Secret strictly on the backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URL_DEV=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URL_PROD=https://addisgebeya.et/auth/google/callback

# Cloudinary Configuration (Keep in backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cheki Payment Verification API (backend-only proxy)
CHEKI_API_BASE_URL=https://cheki.et
CHEKI_TIMEOUT_MS=65000
