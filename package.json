{
  "name": "addisgebeya",
  "version": "0.1.0",
  "private": true,
  "description": "AddisGebeya E-commerce Platform Monorepo",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev:web": "pnpm --filter @addisgebeya/web dev",
    "dev:api": "pnpm --filter @addisgebeya/api dev",
    "build:web": "pnpm build:packages && pnpm --filter @addisgebeya/web build",
    "build:api": "pnpm build:packages && pnpm --filter @addisgebeya/api build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @addisgebeya/api db:generate",
    "db:migrate": "pnpm --filter @addisgebeya/api db:migrate",
    "db:seed": "pnpm --filter @addisgebeya/api db:seed",
    "db:studio": "pnpm --filter @addisgebeya/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
